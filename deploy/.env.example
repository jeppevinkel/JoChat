# docker compose reads this file as .env (copy it; .env is git-ignored).
JOCHAT_IMAGE=ghcr.io/OWNER/jochat:latest

POSTGRES_PASSWORD=change-me

# Authentik OIDC provider (public client; register https://<your-host>/ as a redirect URI).
OIDC_AUTHORITY=https://auth.example.com/application/o/jo-chat/
OIDC_CLIENT_ID=
# Bearer token the Authentik SCIM provider sends to https://<your-host>/v2
SCIM_TOKEN=
# Group names as Authentik provisions them.
USER_GROUP=jochat-users
SUPERADMIN_GROUP=jochat-superadmins

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
