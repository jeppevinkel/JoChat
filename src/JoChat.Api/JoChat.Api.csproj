<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>jochat-api-0f6527a0-5f36-494c-b914-3d930c84094e</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
          <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\JoChat.Core\JoChat.Core.csproj" />
      <ProjectReference Include="..\JoChat.Infrastructure\JoChat.Infrastructure.csproj" />
      <ProjectReference Include="..\JoChat.Providers\JoChat.Providers.csproj" />
    </ItemGroup>

    <!-- Build the web client into wwwroot on publish so a single deployable serves API + SPA.
         Run `dotnet publish` from a machine with Node; `dotnet build` is unaffected. -->
    <PropertyGroup>
        <SpaRoot>$(MSBuildThisFileDirectory)..\JoChat.Web\</SpaRoot>
    </PropertyGroup>
    <Target Name="PublishSpa" BeforeTargets="ComputeFilesToPublish">
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --outDir &quot;$(MSBuildThisFileDirectory)wwwroot&quot; --emptyOutDir" />
        <ItemGroup>
            <_SpaFiles Include="$(MSBuildThisFileDirectory)wwwroot\**" />
            <ResolvedFileToPublish Include="@(_SpaFiles)" RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
        </ItemGroup>
    </Target>

</Project>
