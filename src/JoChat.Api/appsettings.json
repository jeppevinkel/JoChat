{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "MySql"
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Database=jochat;User=jochat;Password=CHANGE_ME"
  },
  "Scim": {
    "Token": ""
  },
  "Oidc": {
    "Authority": "https://auth.example.com/application/o/jochat/",
    "Audience": "jochat"
  },
  "AuthorizationGroups": {
    "UserGroup": "jochat-users",
    "SuperAdminGroup": "jochat-superadmins"
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Storage": {
    "RootPath": "data/files",
    "MaxUploadBytes": 10485760
  },
  "Anthropic": {
    "ApiKey": ""
  },
  "OpenAi": {
    "ApiKey": ""
  },
  "ElevenLabs": {
    "ApiKey": ""
  }
}
